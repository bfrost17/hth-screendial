{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screendial",
  "version": "0.1.0",
  "identifier": "com.screendial.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../.env.local": ".env.local",
      "resources/wakeword/melspectrogram.onnx": "wakeword/melspectrogram.onnx",
      "resources/wakeword/embedding_model.onnx": "wakeword/embedding_model.onnx",
      "resources/wakeword/screendial_wakeword.onnx": "wakeword/screendial_wakeword.onnx"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
